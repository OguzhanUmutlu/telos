#version 460
#extension GL_EXT_buffer_reference : require
#extension GL_EXT_scalar_block_layout : require
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

struct ChunkCullCandidate {
    float min_x;
    float min_y;
    float min_z;
    uint active_mask;      // bit 0: opaque, bit 1: t1, bit 2: cutout, bit 3: translucent

    float max_x;
    float max_y;
    float max_z;
    uint chunk_id;

    int chunk_x;
    int chunk_y;
    int chunk_z;
    uint opaque_pattern_offset;

    uint64_t opaque_quad_address;
    uint opaque_quad_count;
    uint t1_pattern_offset;

    uint64_t t1_quad_address;
    uint t1_quad_count;
    uint cutout_pattern_offset;

    uint64_t cutout_quad_address;
    uint cutout_quad_count;
    uint translucent_pattern_offset;

    uint64_t translucent_quad_address;
    uint translucent_quad_count;
    uint _pad;
};

struct VkDrawIndirectCommand {
    uint vertex_count;
    uint instance_count;
    uint first_vertex;
    uint first_instance;
};

struct TerrainDrawInfo {
    uint64_t quad_buffer_address;
    int chunk_x;
    int chunk_y;
    int chunk_z;
    uint pattern_offset;
    uint _pad;
};

struct CullPointers {
    uint64_t candidate_buffer;
    uint64_t visibility_buffer;
    uint64_t count_buffer;

    uint64_t opaque_cmd;
    uint64_t opaque_draw;

    uint64_t t1_cmd;
    uint64_t t1_draw;

    uint64_t cutout_cmd;
    uint64_t cutout_draw;

    uint64_t translucent_cmd;
    uint64_t translucent_draw;
};

layout(buffer_reference, std430) readonly buffer CandidateBufferRef {
    ChunkCullCandidate candidates[];
};

layout(buffer_reference, std430) buffer VisibilityBufferRef {
    uint visibility[];
};

layout(buffer_reference, std430) buffer CountBufferRef {
    uint counts[]; // [0: opaque, 1: t1, 2: cutout, 3: translucent]
};

layout(buffer_reference, std430) writeonly buffer CommandBufferRef {
    VkDrawIndirectCommand commands[];
};

layout(buffer_reference, std430) writeonly buffer DrawInfoBufferRef {
    TerrainDrawInfo draws[];
};

layout(buffer_reference, std430) readonly buffer PointersBufferRef {
    CullPointers ptrs;
};

layout(set = 0, binding = 0) uniform sampler2D hiz_pyramid;

layout(push_constant, std430) uniform PushConstants {
    mat4 view_proj;
    vec3 camera_pos;
    uint cull_phase; // 0 = early, 1 = late
    uvec2 hiz_size;
    uint candidate_count;
    uint is_first_frame; // 1 = skip hiz occlusion test
    uint64_t pointers_address;
} pc;

bool test_frustum(vec3 bmin, vec3 bmax) {
    vec4 planes[6];
    vec4 r0 = vec4(pc.view_proj[0][0], pc.view_proj[1][0], pc.view_proj[2][0], pc.view_proj[3][0]);
    vec4 r1 = vec4(pc.view_proj[0][1], pc.view_proj[1][1], pc.view_proj[2][1], pc.view_proj[3][1]);
    vec4 r2 = vec4(pc.view_proj[0][2], pc.view_proj[1][2], pc.view_proj[2][2], pc.view_proj[3][2]);
    vec4 r3 = vec4(pc.view_proj[0][3], pc.view_proj[1][3], pc.view_proj[2][3], pc.view_proj[3][3]);

    planes[0] = r3 + r0; // Left
    planes[1] = r3 - r0; // Right
    planes[2] = r3 + r1; // Bottom
    planes[3] = r3 - r1; // Top
    planes[4] = r2;      // Near (z >= 0)
    planes[5] = r3 - r2; // Far  (w - z >= 0)

    for (int i = 0; i < 6; ++i) {
        float len = length(planes[i].xyz);
        if (len > 0.0) {
            planes[i] /= len;
        }

        vec3 p = vec3(
            planes[i].x >= 0.0 ? bmax.x : bmin.x,
            planes[i].y >= 0.0 ? bmax.y : bmin.y,
            planes[i].z >= 0.0 ? bmax.z : bmin.z
        );

        if (dot(planes[i].xyz, p) + planes[i].w < 0.0) {
            return false;
        }
    }
    return true;
}

bool test_hiz_occlusion(vec3 bmin, vec3 bmax) {
    vec2 min_uv = vec2(1.0);
    vec2 max_uv = vec2(0.0);
    float z_near = 0.0; // in reversed-Z: bigger = nearer to camera

    for (int i = 0; i < 8; ++i) {
        vec3 corner = vec3(
            (i & 1) != 0 ? bmax.x : bmin.x,
            (i & 2) != 0 ? bmax.y : bmin.y,
            (i & 4) != 0 ? bmax.z : bmin.z
        );

        vec4 clip = pc.view_proj * vec4(corner, 1.0);
        if (clip.w <= 0.05) {
            return false; // intersects or behind near plane -> visible
        }

        vec3 ndc = clip.xyz / clip.w;
        vec2 uv = ndc.xy * 0.5 + 0.5;

        min_uv = min(min_uv, uv);
        max_uv = max(max_uv, uv);
        z_near = max(z_near, ndc.z);
    }

    min_uv = clamp(min_uv, vec2(0.0), vec2(1.0));
    max_uv = clamp(max_uv, vec2(0.0), vec2(1.0));

    vec2 size_texels = (max_uv - min_uv) * vec2(pc.hiz_size);
    float max_dim = max(max(size_texels.x, size_texels.y), 1.0);
    float lod = ceil(log2(max_dim));

    vec2 sample_uv = (min_uv + max_uv) * 0.5;
    float hiz_depth = textureLod(hiz_pyramid, sample_uv, lod).r;

    // Reversed-Z: z_near < hiz_depth means closest point of AABB is further than the farthest occluder
    return z_near < hiz_depth;
}

void main() {
    uint gid = gl_GlobalInvocationID.x;
    if (gid >= pc.candidate_count) {
        return;
    }

    CullPointers ptrs = PointersBufferRef(pc.pointers_address).ptrs;
    ChunkCullCandidate cand = CandidateBufferRef(ptrs.candidate_buffer).candidates[gid];

    uint vis = VisibilityBufferRef(ptrs.visibility_buffer).visibility[cand.chunk_id];

    if (pc.cull_phase == 0u) {
        // Early phase: only test candidates visible last frame
        if (vis == 0u) {
            return;
        }
    } else {
        // Late phase: only test candidates NOT drawn in early phase
        if (vis != 0u) {
            return;
        }
    }

    vec3 bmin = vec3(cand.min_x, cand.min_y, cand.min_z);
    vec3 bmax = vec3(cand.max_x, cand.max_y, cand.max_z);

    // Frustum test
    if (!test_frustum(bmin, bmax)) {
        VisibilityBufferRef(ptrs.visibility_buffer).visibility[cand.chunk_id] = 0u;
        return;
    }

    // Hi-Z occlusion test
    if (pc.is_first_frame == 0u && test_hiz_occlusion(bmin, bmax)) {
        VisibilityBufferRef(ptrs.visibility_buffer).visibility[cand.chunk_id] = 0u;
        return;
    }

    // Candidate survived both frustum and occlusion tests
    VisibilityBufferRef(ptrs.visibility_buffer).visibility[cand.chunk_id] = 1u;

    // Emit commands and DrawInfo for active layers
    if ((cand.active_mask & 1u) != 0u && cand.opaque_quad_count > 0u) {
        uint slot = atomicAdd(CountBufferRef(ptrs.count_buffer).counts[0], 1u);
        CommandBufferRef(ptrs.opaque_cmd).commands[slot] = VkDrawIndirectCommand(
            cand.opaque_quad_count * 6u,
            1u,
            0u,
            slot
        );
        DrawInfoBufferRef(ptrs.opaque_draw).draws[slot] = TerrainDrawInfo(
            cand.opaque_quad_address,
            cand.chunk_x,
            cand.chunk_y,
            cand.chunk_z,
            cand.opaque_pattern_offset,
            0u
        );
    }

    if ((cand.active_mask & 2u) != 0u && cand.t1_quad_count > 0u) {
        uint slot = atomicAdd(CountBufferRef(ptrs.count_buffer).counts[1], 1u);
        CommandBufferRef(ptrs.t1_cmd).commands[slot] = VkDrawIndirectCommand(
            cand.t1_quad_count * 6u,
            1u,
            0u,
            slot
        );
        DrawInfoBufferRef(ptrs.t1_draw).draws[slot] = TerrainDrawInfo(
            cand.t1_quad_address,
            cand.chunk_x,
            cand.chunk_y,
            cand.chunk_z,
            cand.t1_pattern_offset,
            0u
        );
    }

    if ((cand.active_mask & 4u) != 0u && cand.cutout_quad_count > 0u) {
        uint slot = atomicAdd(CountBufferRef(ptrs.count_buffer).counts[2], 1u);
        CommandBufferRef(ptrs.cutout_cmd).commands[slot] = VkDrawIndirectCommand(
            cand.cutout_quad_count * 6u,
            1u,
            0u,
            slot
        );
        DrawInfoBufferRef(ptrs.cutout_draw).draws[slot] = TerrainDrawInfo(
            cand.cutout_quad_address,
            cand.chunk_x,
            cand.chunk_y,
            cand.chunk_z,
            cand.cutout_pattern_offset,
            0u
        );
    }

    // Translucent geometry is drawn in the late pass after all opaque depth is finalized
    if (pc.cull_phase == 1u && (cand.active_mask & 8u) != 0u && cand.translucent_quad_count > 0u) {
        uint slot = atomicAdd(CountBufferRef(ptrs.count_buffer).counts[3], 1u);
        CommandBufferRef(ptrs.translucent_cmd).commands[slot] = VkDrawIndirectCommand(
            cand.translucent_quad_count * 6u,
            1u,
            0u,
            slot
        );
        DrawInfoBufferRef(ptrs.translucent_draw).draws[slot] = TerrainDrawInfo(
            cand.translucent_quad_address,
            cand.chunk_x,
            cand.chunk_y,
            cand.chunk_z,
            cand.translucent_pattern_offset,
            0u
        );
    }
}
